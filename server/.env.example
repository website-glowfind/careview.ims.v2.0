# ── Server configuration ─────────────────────────────────────────────
# Copy this file to ".env" on each machine and fill in the real values.
# The real .env is gitignored (it holds secrets) and is NOT pushed to GitHub,
# so you must create it manually after cloning.

# Port the server listens on. The app is served here (frontend + API).
PORT=3001

# Set to "production" when running as the LAN/server deployment.
# "development" also works for local coding (Vite dev on :5173 + this API).
NODE_ENV=production

# MongoDB connection string.
#   Local MongoDB:  mongodb://127.0.0.1:27017/hris
#   MongoDB Atlas:  mongodb+srv://<user>:<password>@<cluster>/hris
MONGO_URI=your-mongodb-connection-string-here

# (Optional/legacy) alternate DB URL if used elsewhere.
DATABASE_URL=

# Secret used to sign JWT auth tokens. Use a long random string.
JWT_SECRET=change-me-to-a-long-random-secret
